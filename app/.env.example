# Only the variables the app actually reads. Anything not listed here is not
# consumed by any code path — the previous example carried nine such leftovers.
#
# In the cluster these come from Bitwarden via External Secrets as
# horpakjs_<KEY>, except NODE_ENV / BASE_URL / NEXTAUTH_URL /
# GOOGLE_REDIRECT_URI, which the Helm chart derives from the hostname.

NODE_ENV=production

MONGO_URI=mongodb://user:password@db-name.mongodb.net:27017/?ssl=true&authSource=xxx
DB_NAME=db-name

# NextAuth session encryption. This is the only session secret the app has;
# there is no JWT signing anywhere in the codebase.
NEXTAUTH_SECRET=SECRET
NEXTAUTH_URL=http://localhost:3000
BASE_URL=http://localhost:3000

GOOGLE_ID=12345-xxx.apps.googleusercontent.com
GOOGLE_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/spreadsheet/callback

# firebase-admin only. The Firebase client SDK is never initialised, so the
# FIREBASE_API_KEY / AUTH_DOMAIN / PROJECT_ID / ... client values are not needed.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"app-name","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nabc\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@app-name.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40app-name.iam.gserviceaccount.com"}

# Cloudflare Turnstile server-side verification. The public key is hard-coded in
# config/constants.ts.
TURNSTILE_SECRET=
